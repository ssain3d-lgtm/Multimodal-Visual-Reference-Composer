      "parent": null,
      "children": [],
      "description": "The subject is tiny inside a huge environment, so the place matters more than the person. Framing describes how much of the scene the frame contains, not how far away the camera physically stood.",
      "examples": [
        "a lone figure crossing an empty desert",
        "a climber as a dot on a vast rock face"
      ],
      "conflicts_with": [
        "camera_distance.macro",
        "lens.macro_like"
      ],
      "exclusivity_group": "shot_size",
      "prompt_fragment": "extreme wide shot",
      "negative_fragment": "not an extreme wide shot",
      "search_boost": 1.2,
      "sort_order": 10
    },
